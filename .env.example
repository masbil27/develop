# Salin file ini menjadi ".env" lalu isi nilainya. Jangan pernah commit file ".env" ke git.

# Provider transkripsi: "openrouter" atau "openai"
TRANSCRIPTION_PROVIDER=openrouter

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
# Model audio-capable di OpenRouter, mis. openai/gpt-4o-audio-preview atau google/gemini-2.0-flash-001
OPENROUTER_MODEL=openai/gpt-4o-audio-preview

# --- OpenAI (fallback, https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Bahasa dominan untuk membantu prompt/hint transkripsi (id, en, atau mixed)
TRANSCRIPTION_LANGUAGE_HINT=mixed

# Panjang tiap chunk audio dalam detik sebelum dikirim ke API (default 300 = 5 menit)
CHUNK_SECONDS=300

# Port web app
PORT=5000
